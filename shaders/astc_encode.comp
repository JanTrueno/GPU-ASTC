// GPU-ASTC: ASTC LDR block encoder, OpenGL ES 3.1 compute shader.
//
// The host prepends "#version 310 es" and the option defines below.
//
// Derived from niepp/astc_encoder (MIT, Copyright (c) 2021 niedap),
// ported from HLSL. See THIRD_PARTY_NOTICES.md.
//
// One invocation encodes one block. Every block size stores one weight per texel:
//   4x4: 12 weight levels (6 for blocks with alpha)
//   5x5:  5 weight levels (3 for blocks with alpha)
//   6x6:  3 weight levels (2 for blocks with alpha)
// Endpoints are 8 bit. A block of an alpha texture that is in fact opaque is stored as RGB.
// 4x4 blocks that one colour line fits badly also try two partitions (and, with alpha, two planes).
// Opaque 5x5 and 6x6 blocks also try a 4x4 grid of 12-level weights, which suits smooth gradients.

precision highp float;
precision highp int;
precision highp sampler2D;
precision highp usampler2D;

#ifndef BLOCK_DIM
#define BLOCK_DIM 4   // block size: 4, 5 or 6 (4x4, 5x5, 6x6)
#endif
#ifndef HAS_ALPHA
#define HAS_ALPHA 0
#endif
#ifndef PREMULTIPLIED
#define PREMULTIPLIED 0 // colour already multiplied by alpha (XNA content): errors count unweighted
#endif
#ifndef IS_NORMALMAP
#define IS_NORMALMAP 0
#endif
#ifndef INPUT_BUFFER
#define INPUT_BUFFER 0 // 1: the source pixels come from a buffer (one uint per texel), not a texture
#endif
#ifndef USE_PARTITIONS
#define USE_PARTITIONS 1 // 4x4 only; needs the partition table texture (uPartLut)
#endif

#define DIM BLOCK_DIM
#define BLOCK_SIZE ((DIM) * (DIM))

#if BLOCK_DIM == 4
#define TWO_PARTITIONS USE_PARTITIONS
#define DUAL_PLANE HAS_ALPHA
#else
#define TWO_PARTITIONS 0
#define DUAL_PLANE 0
#endif

#ifndef USE_GRID
#define USE_GRID 1
#endif
#if BLOCK_DIM != 4 && !HAS_ALPHA
#define GRID_MODE USE_GRID
#else
#define GRID_MODE 0
#endif
// the squared error of the first encoding is only worked out where something is compared with it
#if BLOCK_DIM == 4 || GRID_MODE
#define NEED_ERR 1
#else
#define NEED_ERR 0
#endif

#define SMALL_VALUE 0.00001

// Colour type: opaque textures work on RGB only, which keeps more of the block state in registers.
#if HAS_ALPHA
#define TV vec4
#define TV_FROM4(v) (v)
#else
#define TV vec3
#define TV_FROM4(v) (v).rgb
#endif

// With straight alpha, colour errors count in proportion to the source alpha (the colour under a
// transparent pixel is invisible); alpha errors count fully. Sums over texels then come in pairs
// (x: colour channels, y: alpha).
#if HAS_ALPHA && !PREMULTIPLIED
#define WEIGHTED 1
#define S2 vec2
#define PER_CHANNEL(v) (v).xxxy
#define SUM2(v) ((v).x + (v).y)
#define DOT2(a, b) dot(a, b)
#else
#define WEIGHTED 0
#define S2 float
#define PER_CHANNEL(v) (v)
#define SUM2(v) (v)
#define DOT2(a, b) ((a) * (b))
#endif

#define CEM_LDR_RGB_DIRECT 8u
#define CEM_LDR_RGBA_DIRECT 12u

// Block modes ("Table C.2.8 - 2D Block Mode Layout"): weight grid size and weight range.
#define MODE_4x4_Q12 0x251u
#define MODE_4x4_Q6  0x043u
#define MODE_4x4_Q3  0x051u
#define MODE_4x4_Q4  0x042u
#define MODE_4x4_Q2_DUAL 0x441u
#define MODE_5x5_Q5  0x0F2u
#define MODE_5x5_Q3  0x0F1u
#define MODE_6x6_Q3  0x114u
#define MODE_6x6_Q2  0x104u

// Weights are packed in groups of five (trits, or single bits) or three (quints).

// Sum of squared error over a block above which the more expensive encodings are tried.
#ifndef ALT_ERR_THRESHOLD
#define ALT_ERR_THRESHOLD 256.0
#endif
// The dual-plane check is cheap next to the partition search and catches "transparent + two
// colours" blocks whose single-plane error is small in absolute terms, so it starts earlier.
#ifndef DUAL_ERR_THRESHOLD
#define DUAL_ERR_THRESHOLD 16.0
#endif
// 5x5 / 6x6: the 4x4 weight grid is tried when rounding the weights to their few levels costs
// more squared error than this. Blocks of hard edges round to the ends of the line for free and
// skip it.
#ifndef GRID_ERR_THRESHOLD
#define GRID_ERR_THRESHOLD 20.0
#endif
// ... and only for smooth blocks: the squared weight steps between horizontal neighbours, as a
// share of the weights' spread. A ramp across the block is about 0.3, noise about 1.7.
#ifndef GRID_SMOOTH
#define GRID_SMOOTH 0.4
#endif

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform ivec2 uTexSize;   // source size in texels
uniform ivec2 uBlocks;    // size in blocks
uniform int uN;           // BLOCK_SIZE (non-constant so loops are not unrolled)
#if INPUT_BUFFER
// Uploading a texture is slow on some drivers (Mali: 35-40 ms per megapixel, more than encoding
// it); a buffer is a plain copy. Row-major, R in the low byte.
layout(std430, binding = 1) readonly buffer InBuffer { uint pixels[]; };
#else
layout(binding = 0) uniform highp sampler2D uTex;
#endif
#if TWO_PARTITIONS
// 256x256, R32UI: for every 16 bit "which side is each texel on" mask, the closest 2-partition
// pattern the format offers: seed in bits 0-9, number of texels that differ in bits 10-14,
// the pattern's own mask in bits 16-31.
layout(binding = 1) uniform highp usampler2D uPartLut;
#endif
layout(std430, binding = 0) writeonly buffer OutBuffer { uvec4 blocks[]; };

// ---------------------------------------------------------------------------
// bit packing. Everything is pure arithmetic: no lookup tables, so nothing is spilled to memory.
// ---------------------------------------------------------------------------

// Or v into the 128 bit string o at bit pos.
void put(inout uvec4 o, uint pos, uint v)
{
    uint i = pos >> 5u;
    uint s = pos & 31u;
    uint lo = v << s;
    uint hi = (s == 0u) ? 0u : (v >> (32u - s));
    if (i == 0u)      { o.x |= lo; o.y |= hi; }
    else if (i == 1u) { o.y |= lo; o.z |= hi; }
    else if (i == 2u) { o.z |= lo; o.w |= hi; }
    else              { o.w |= lo; }
}

// Packs five trits (0..2) into the 8 bit ASTC trit block. Same values as the
// reference integer_from_trits table, derived from the spec's decode rules.
uint pack_trits(uint t0, uint t1, uint t2, uint t3, uint t4)
{
    uint c;
    if (t2 == 2u)
        c = (t1 == 2u) ? (12u + t0) : ((t1 << 4u) | ((t0 == 2u) ? 12u : (t0 << 2u)) | 3u);
    else
        c = (t2 << 4u) | (t1 << 2u) | t0;

    if (t3 == 2u && t4 == 2u)
    {
        if (t2 == 2u && t1 == 2u) c |= 16u;
        return ((c >> 2u) << 5u) | 28u | (c & 3u);
    }
    if ((c >> 2u) == 7u) c &= ~4u;
    return (t4 == 2u) ? (c | (3u << 5u) | (t3 << 7u))
                      : (c | (t3 << 5u) | (t4 << 7u));
}

// Packs three quints (0..4) into the 7 bit ASTC quint block (inverse of the spec's decode rules).
uint pack_quints(uint q0, uint q1, uint q2)
{
    if (q0 == 4u && q1 == 4u)
        return (q2 == 4u) ? 7u : (6u | ((q2 & 1u) << 3u) | ((q2 >> 1u) << 4u));
    uint c = (q1 == 4u) ? ((q0 << 3u) | 5u) : ((q1 << 3u) | q0);
    if (q2 == 4u)
        return (c & 0x18u) | ((~c & 6u) << 4u) | 6u | (c & 1u);
    return (q2 << 5u) | c;
}

// Bit string of one group of five values (4 bits each in grp: trit above nb low bits):
// the low-bit fields interleaved with the 8 trit bits. 5 * nb + 8 bits.
uint trit_group_bits(uint grp, uint nb)
{
    uint m = (1u << nb) - 1u;
    uint q0 = grp & 15u, q1 = (grp >> 4u) & 15u, q2 = (grp >> 8u) & 15u, q3 = (grp >> 12u) & 15u, q4 = (grp >> 16u) & 15u;
    uint t = pack_trits(q0 >> nb, q1 >> nb, q2 >> nb, q3 >> nb, q4 >> nb);
    uint g = q0 & m;                 uint s = nb;
    g |= (t & 3u) << s;              s += 2u;
    g |= (q1 & m) << s;              s += nb;
    g |= ((t >> 2u) & 3u) << s;      s += 2u;
    g |= (q2 & m) << s;              s += nb;
    g |= ((t >> 4u) & 1u) << s;      s += 1u;
    g |= (q3 & m) << s;              s += nb;
    g |= ((t >> 5u) & 3u) << s;      s += 2u;
    g |= (q4 & m) << s;              s += nb;
    g |= (t >> 7u) << s;
    return g;
}

// Weight index (0 = endpoint 0 ... levels-1 = endpoint 1) -> stored value, and -> the weight the
// decoder uses (0..1). q12 picks between the two 4x4 ranges; 5x5 and 6x6 have one range each.
#if BLOCK_DIM == 4 || GRID_MODE
uint scramble_weight(uint q, bool q12)
{
    if (q12)
    {
        uint v = (q < 8u) ? (0x7BA62840u >> (q * 4u))            // {0,4,8,2,6,10,11,7,3,9,5,1}
                          : (0x1593u >> ((q - 8u) * 4u));
        return v & 15u;
    }
    return (0x135420u >> (q * 4u)) & 15u;                        // {0,2,4,5,3,1}
}

float unquant_weight(uint q, bool q12)
{
    uint v;
    if (q12)
    {
        // {0,5,11,17,23,28,36,41,47,53,59,64}
        v = (((5u << 5u) | (11u << 10u) | (17u << 15u) | (23u << 20u) | (28u << 25u)) >> (min(q, 11u - q) * 5u)) & 31u;
        if (q > 5u) v = 64u - v;
    }
    else
    {
        // {0,12,25,39,52,64}
        v = (((12u << 5u) | (25u << 10u)) >> (min(q, 5u - q) * 5u)) & 31u;
        if (q > 2u) v = 64u - v;
    }
    return float(v) * (1.0 / 64.0);
}
#endif

// ---------------------------------------------------------------------------
// texels
// ---------------------------------------------------------------------------

// Texels are re-fetched from the texture in each pass instead of being kept in
// registers: a 4x4 block would otherwise need 64 registers just for its pixels.
ivec2 g_origin; // first texel of this thread's block

TV texel(int k)
{
    int y = k / DIM;
    int x = k - y * DIM;
    // replicate edge texels for partial blocks
    ivec2 p = min(g_origin + ivec2(x, y), uTexSize - ivec2(1));
#if INPUT_BUFFER
    uint v = pixels[p.y * uTexSize.x + p.x];
#if IS_NORMALMAP
    v |= 0xFFFF0000u;
#endif
    return TV_FROM4(vec4(uvec4(v, v >> 8u, v >> 16u, v >> 24u) & 255u));
#else
    vec4 t = texelFetch(uTex, p, 0);
#if IS_NORMALMAP
    t.b = 1.0;
    t.a = 1.0;
#endif
    return TV_FROM4(t) * 255.0;
#endif
}

// Error metric used to choose between encodings. With straight alpha the RGB error counts in
// proportion to the source alpha (the colour under a transparent pixel is invisible).
#if DUAL_PLANE
float pixel_error(vec4 t, vec4 decoded)
{
    vec4 d = t - decoded;
#if WEIGHTED
    return (t.a * (1.0 / 255.0)) * dot(d.rgb, d.rgb) + d.a * d.a;
#else
    return dot(d, d);
#endif
}
#endif

// ---------------------------------------------------------------------------
// endpoints
// ---------------------------------------------------------------------------

// Power iteration for the dominant axis of a symmetric covariance matrix, given as its unique
// entries: xr = (rr, rg, rb), xg = (gg, gb, bb), xa = (ra, ga, ba, aa). The original used 8
// iterations. Starting from the highest-variance column, quality is unchanged down to 1 (measured
// on photos and sprites; 0 loses ~0.1 dB on photos), which removes about 20% of the arithmetic.
// A fixed start vector can be orthogonal to the real axis (for example a block that only varies in
// alpha, where a start vector with alpha = 0 is sent to zero).
#define EIGEN_ITERATIONS 1
vec3 cov_mul(vec3 xr, vec3 xg, vec3 v)
{
    return vec3(dot(xr, v), dot(vec3(xr.y, xg.xy), v), dot(vec3(xr.z, xg.yz), v));
}

vec3 eigen_vector3(vec3 xr, vec3 xg)
{
    vec3 v = xr;
    float best = xr.x;
    if (xg.x > best) { v = vec3(xr.y, xg.xy); best = xg.x; }
    if (xg.z > best) { v = vec3(xr.z, xg.yz); }
    for (int i = 0; i < EIGEN_ITERATIONS; ++i)
    {
        v = cov_mul(xr, xg, v);
        if (length(v) < SMALL_VALUE)
            return v;
        v = normalize(cov_mul(xr, xg, v));
    }
    return v;
}

#if HAS_ALPHA
vec4 cov_mul(vec3 xr, vec3 xg, vec4 xa, vec4 v)
{
    return vec4(cov_mul(xr, xg, v.rgb) + xa.xyz * v.a, dot(xa, v));
}

vec4 eigen_vector4(vec3 xr, vec3 xg, vec4 xa)
{
    vec4 v = vec4(xr, xa.x);
    float best = xr.x;
    if (xg.x > best) { v = vec4(xr.y, xg.xy, xa.y); best = xg.x; }
    if (xg.z > best) { v = vec4(xr.z, xg.yz, xa.z); best = xg.z; }
    if (xa.w > best) { v = xa; }
    for (int i = 0; i < EIGEN_ITERATIONS; ++i)
    {
        v = cov_mul(xr, xg, xa, v);
        if (length(v) < SMALL_VALUE)
            return v;
        v = normalize(cov_mul(xr, xg, xa, v));
    }
    return v;
}
#endif

// Endpoints are stored with 8, 6 or 4 bits per channel; the decoder expands by bit replication.
TV ep_quant(TV e, int bits)
{
    float qmax = (bits == 8) ? 255.0 : ((bits == 6) ? 63.0 : 15.0);
    return floor(clamp(e, 0.0, 255.0) * (qmax / 255.0) + 0.5);
}

TV ep_unquant(TV q, int bits)
{
    if (bits == 8) return q;
    if (bits == 6) return q * 4.0 + floor(q * (1.0 / 16.0));
    return q * 17.0;
}

// Quantizes an endpoint pair. The decoder swaps the two (blue contraction) unless the second has
// the larger RGB sum, so the pair is put in that order. q: stored values, u: what the decoder sees.
void ep_pair(TV lo, TV hi, int bits, out TV q0, out TV q1, out TV u0, out TV u1)
{
    q0 = ep_quant(lo, bits); u0 = ep_unquant(q0, bits);
    q1 = ep_quant(hi, bits); u1 = ep_unquant(q1, bits);
    if (u0.r + u0.g + u0.b > u1.r + u1.g + u1.b)
    {
        TV t = q0; q0 = q1; q1 = t;
        t = u0; u0 = u1; u1 = t;
    }
}

// Least-squares endpoints for one group of texels whose weights are chosen, from sums over the
// group: nn = sum(om), sw = sum(om*w), sww = sum(om*w*w), swt = sum(om*w*t), st = sum(om*t),
// where om is 1, or with straight alpha the weight of the texel's colour / alpha error.
// The pair is replaced when the system is solvable and the result keeps its order.
void refit(S2 nn, S2 sw, S2 sww, TV swt, TV st, int bits, inout TV q0, inout TV q1)
{
    S2 al = nn - 2.0 * sw + sww;
    S2 be = sw - sww;
    S2 det = al * sww - be * be;
#if WEIGHTED
    if (det.x < 0.01 || det.y < 0.01)
        return;
#else
    if (det < 0.01)
        return;
#endif
    TV a = st - swt;
    TV r0 = ep_quant((PER_CHANNEL(sww) * a - PER_CHANNEL(be) * swt) / PER_CHANNEL(det), bits);
    TV r1 = ep_quant((PER_CHANNEL(al) * swt - PER_CHANNEL(be) * a) / PER_CHANNEL(det), bits);
    a = ep_unquant(r1, bits) - ep_unquant(r0, bits);
    if (a.r + a.g + a.b >= 0.0)
    {
        q0 = r0;
        q1 = r1;
    }
}

// Squared error of a group stored with the pair q0, q1: sum(om * (t - u0 - w*(u1-u0))^2), expanded
// into the sums above and sqq = sum(om*t*t).
float group_error(S2 nn, S2 sw, S2 sww, TV swt, TV st, float sqq, int bits, TV q0, TV q1)
{
    TV u = ep_unquant(q0, bits);
    TV d = ep_unquant(q1, bits) - u;
    return sqq + dot(u, u * PER_CHANNEL(nn) - 2.0 * st + 2.0 * d * PER_CHANNEL(sw)) + dot(d, d * PER_CHANNEL(sww) - 2.0 * swt);
}

// Writes an endpoint pair as r0 r1 g0 g1 b0 b1 [a0 a1].
void put_endpoints(inout uvec4 blk, inout uint pos, TV q0, TV q1, int bits, bool rgba)
{
#if HAS_ALPHA
    uvec4 a = uvec4(q0);
    uvec4 b = uvec4(q1);
#else
    uvec3 a = uvec3(q0);
    uvec3 b = uvec3(q1);
#endif
    uint n = uint(bits);
    put(blk, pos, a.r | (b.r << n)); pos += 2u * n;
    put(blk, pos, a.g | (b.g << n)); pos += 2u * n;
    put(blk, pos, a.b | (b.b << n)); pos += 2u * n;
#if HAS_ALPHA
    if (rgba)
    {
        put(blk, pos, a.a | (b.a << n)); pos += 2u * n;
    }
#endif
}

// Weights are stored bit-reversed from the end of the block. No mode here has more than 64 bits.
void put_weights(inout uvec4 blk, uvec2 ws)
{
    blk.w |= bitfieldReverse(ws.x);
    blk.z |= bitfieldReverse(ws.y);
}

// Or v into the 64 bit string o at bit pos.
void put2(inout uvec2 o, uint pos, uint v)
{
    uint s = pos & 31u;
    if (pos < 32u)
    {
        o.x |= v << s;
        if (s != 0u) o.y |= v >> (32u - s);
    }
    else
    {
        o.y |= v << s;
    }
}

// ---------------------------------------------------------------------------
// one partition, one plane: three passes over the block
//   1. mean, covariance, flat test          -> main axis
//   2. extent of the texels along the axis  -> endpoints
//   3. weights against the stored endpoints -> bits, least-squares sums
// then the endpoints are moved along their line to the least-squares positions for the weights
// that were chosen. Only sums of scalars are carried through pass 3: every value that stays alive
// in that loop costs registers, and past 32 a Mali Bifrost core runs half as many threads.
// Returns the stored endpoints (e0, e1), the squared error and the texel farthest off the line.
// ---------------------------------------------------------------------------

uvec4 encode_block(out float err, out float round_err, out bool opaque, out TV e0, out TV e1, out int far)
{
    // pass 1. Moments are taken relative to the first texel: sums of products of raw 0..255
    // values would lose the low bits that the covariance of a smooth block lives in.
    TV ref = texel(0);
    TV s = TV(0.0);
    vec3 xr = vec3(0.0); // r*r, r*g, r*b
    vec3 xg = vec3(0.0); // g*g, g*b, b*b
#if HAS_ALPHA
    vec4 xa = vec4(0.0); // a*(r, g, b, a)
    float amin = 0.0;
#endif
    for (int i = 1; i < uN; ++i)
    {
        TV c = texel(i) - ref;
        s += c;
        xr += c.r * c.rgb;
        xg += vec3(c.g * c.gb, c.b * c.b);
#if HAS_ALPHA
        xa += c.a * c;
        amin = min(amin, c.a);
#endif
    }

    err = 0.0;
    round_err = 0.0;
    far = 0;
    e0 = ref;
    e1 = ref;
#if HAS_ALPHA
    opaque = ref.a + amin > 254.5;
    float sqc = xr.x + xg.x + xg.z + xa.w; // sum of squared distances to the first texel
#else
    opaque = true;
    float sqc = xr.x + xg.x + xg.z;
#endif

    // Every texel the same colour: constant-colour (void-extent) block. No axis, weights or
    // bit packing needed, and it is exact. 8 bit -> 16 bit UNORM is a multiply by 257.
    if (sqc == 0.0)
    {
#if HAS_ALPHA
        uvec4 c = uvec4(round(ref)) * 257u;
#else
        uvec4 c = uvec4(uvec3(round(ref)) * 257u, 65535u);
#endif
        return uvec4(0xFFFFFDFCu, 0xFFFFFFFFu, c.r | (c.g << 16u), c.b | (c.a << 16u));
    }

    const float n = float(BLOCK_SIZE);
    TV mc = s * (1.0 / n);
    TV mean = ref + mc;
    xr -= s.r * mc.rgb;
    xg -= vec3(s.g * mc.gb, s.b * mc.b);
#if HAS_ALPHA
    xa -= s.a * mc;
    TV axis = eigen_vector4(xr, xg, xa);
#else
    TV axis = eigen_vector3(xr, xg);
#endif

    // pass 2
    float lo = 1e31;
    float hi = -1e31;
    for (int i = 0; i < uN; ++i)
    {
        float p = dot(texel(i) - mean, axis);
        lo = min(lo, p);
        hi = max(hi, p);
    }

    // Storage: alpha blocks that are in fact opaque are stored as RGB, which frees bits.
    const int ebits = 8;
#if BLOCK_DIM == 4
    bool q12 = opaque;
    float wmax = q12 ? 11.0 : 5.0;
    uint nb = q12 ? 2u : 1u;
    uint mode = q12 ? MODE_4x4_Q12 : MODE_4x4_Q6;
    const uint group4 = 20u; // 4 * weights per group
#elif BLOCK_DIM == 5
    float wmax = opaque ? 4.0 : 2.0;
    uint mode = opaque ? MODE_5x5_Q5 : MODE_5x5_Q3;
    uint group4 = opaque ? 12u : 20u;
#else
    float wmax = opaque ? 2.0 : 1.0;
    uint mode = opaque ? MODE_6x6_Q3 : MODE_6x6_Q2;
    const uint group4 = 20u;
#endif

    {
        TV q0, q1;
        ep_pair(mean + axis * lo, mean + axis * hi, ebits, q0, q1, e0, e1);
    }
    TV d = e1 - e0;
#if WEIGHTED
    vec2 dd = vec2(dot(d.rgb, d.rgb), d.a * d.a);
#else
    float dd = dot(d, d);
#endif
    float inv = 1.0 / max(SUM2(dd), SMALL_VALUE);

    // pass 3. With c = t - e0 and p = c.d, per texel: sw = sum(w), sww = sum(w*w), sp = sum(p),
    // swp = sum(w*p), scc = sum(c.c). With straight alpha each is a pair (colour, alpha) and the
    // colour part is weighted by the texel's alpha.
    uvec2 ws = uvec2(0u);
    S2 sw = S2(0.0);
    S2 sww = S2(0.0);
    S2 sp = S2(0.0);
    S2 swp = S2(0.0);
#if NEED_ERR
    S2 scc = S2(0.0);
    float worst = -1.0;
#endif
#if GRID_MODE
    float wprev = 0.0, rough = 0.0, siw = 0.0, siww = 0.0; // previous weight, sum of squared steps, sums of w and w*w
    int col = 0;
#endif
#if WEIGHTED
    vec2 nn = vec2(0.0, n);
#else
    const float nn = n;
#endif
    uint grp = 0u;  // the weights of the group being filled, 4 bits each
    uint gsh = 0u;  // 4 * weights in grp
    uint wpos = 0u; // bits written to ws
    for (int i = 0; i < uN; ++i)
    {
        {
            TV c = texel(i) - e0;
#if WEIGHTED
            vec2 om = vec2((c.a + e0.a) * (1.0 / 255.0), 1.0);
            vec2 pc = om * vec2(dot(c.rgb, d.rgb), c.a * d.a);
            nn.x += om.x;
#else
            const float om = 1.0;
            float pc = dot(c, d);
#endif
#if WEIGHTED
            // least-squares weight under the same per-channel weights (a transparent texel is
            // placed by its alpha alone)
            float w = clamp(SUM2(pc) / max(dot(om, dd), SMALL_VALUE), 0.0, 1.0);
#else
            float w = clamp(pc * inv, 0.0, 1.0);
#endif
            uint q = uint(w * wmax + 0.5);
#if BLOCK_DIM == 4
            float wu = unquant_weight(q, q12);
            q = scramble_weight(q, q12);
#else
            float wu = float(q) * (1.0 / wmax);
#endif
#if GRID_MODE
            round_err += (w - wu) * (w - wu);
            if (col != 0) rough += (w - wprev) * (w - wprev);
            col = (col == DIM - 1) ? 0 : col + 1;
            wprev = w;
            siw += w;
            siww += w * w;
#endif
            sw += wu * om;
            sww += wu * wu * om;
            sp += pc;
            swp += wu * pc;
#if NEED_ERR
#if WEIGHTED
            vec2 cc = om * vec2(dot(c.rgb, c.rgb), c.a * c.a);
#else
            float cc = dot(c, c);
#endif
            scc += cc;
#if TWO_PARTITIONS
            // squared distance from the line (not the segment): the third colour of the block
#if WEIGHTED
            float cd = dot(c, d);
            float off = dot(c, c) - cd * cd / max(dot(d, d), SMALL_VALUE);
#else
            float off = cc - pc * pc * inv;
#endif
            if (off > worst) { worst = off; far = i; }
#endif
#endif
            grp |= q << gsh;
            gsh += 4u;
        }
        // group full, or last texel: pack it
        if (gsh == group4 || i == uN - 1)
        {
#if BLOCK_DIM == 5
            if (opaque) { put2(ws, wpos, pack_quints(grp & 15u, (grp >> 4u) & 15u, (grp >> 8u) & 15u)); wpos += 7u; }
            else        { put2(ws, wpos, trit_group_bits(grp, 0u)); wpos += 8u; }
#elif BLOCK_DIM == 6
            if (opaque) { put2(ws, wpos, trit_group_bits(grp, 0u)); wpos += 8u; }
            else        { put2(ws, wpos, (grp & 1u) | ((grp >> 3u) & 2u) | ((grp >> 6u) & 4u) | ((grp >> 9u) & 8u) | ((grp >> 12u) & 16u)); wpos += 5u; }
#else
            put2(ws, wpos, trit_group_bits(grp, nb));
            wpos += 5u * nb + 8u;
#endif
            grp = 0u;
            gsh = 0u;
        }
    }

    // Refit: the texel with weight w is decoded as e0 + (a + (b - a) * w) * d; a = 0, b = 1 are the
    // endpoints as they are. Least squares for a and b (2x2 system), then the error for them.
    float al = DOT2(dd, nn - 2.0 * sw + sww);
    float be = DOT2(dd, sw - sww);
    float ga = DOT2(dd, sww);
    float r1 = SUM2(swp);
    float r0 = SUM2(sp) - r1;
    float det = al * ga - be * be;
    float a = 0.0;
    float b = 1.0;
    if (det > 1e-4 * (al + ga) * (al + ga))
    {
        a = (ga * r0 - be * r1) / det;
        b = (al * r1 - be * r0) / det;
        // 8 bit endpoints: the stored values are the decoded ones
        TV n0 = ep_quant(e0 + a * d, ebits);
        TV n1 = ep_quant(e0 + b * d, ebits);
        TV dn = n1 - n0;
        if (dn.r + dn.g + dn.b >= 0.0)
        {
            e0 = n0;
            e1 = n1;
        }
        else
        {
            a = 0.0;
            b = 1.0;
        }
    }
#if NEED_ERR
    err = SUM2(scc) - 2.0 * (a * r0 + b * r1) + a * a * al + 2.0 * a * b * be + b * b * ga;
#endif
#if GRID_MODE
    // not smooth: the grid cannot follow it, do not try
    round_err = (rough > GRID_SMOOTH * (siww - siw * siw / n)) ? 0.0 : round_err * dd;
#endif

    uvec4 blk = uvec4(0u);
    blk.x = mode | ((opaque ? CEM_LDR_RGB_DIRECT : CEM_LDR_RGBA_DIRECT) << 13u);
    uint pos = 17u;
    put_endpoints(blk, pos, e0, e1, ebits, !opaque);
    put_weights(blk, ws);
    return blk;
}

// ---------------------------------------------------------------------------
// 4x4 weight grid for 5x5 and 6x6 blocks (opaque only)
//
// One weight per texel leaves 5x5 with 5 weight levels and 6x6 with 3. A block that is one smooth
// gradient is better served by 16 weights of 12 levels that the decoder interpolates across the
// block. Two passes: the grid weights, then the texels as the decoder will rebuild them, which
// gives the refit sums and the error that decides between the two encodings.
// ---------------------------------------------------------------------------

#if GRID_MODE
// Wanted weight of grid cell i: the projection of the texels around it onto the endpoint line.
float grid_weight(int i, TV e0, TV dn)
{
    int gx = i & 3;
    int gy = i >> 2;
#if BLOCK_DIM == 6
    // cell (gx, gy) covers texels x0..x0+1, y0..y0+1 with x0, y0 in {0,1,3,4}; the nearer the
    // texel the larger its share (4/9, 2/9, 2/9, 1/9)
    int x0 = gx + (gx >> 1);
    int y0 = gy + (gy >> 1);
    int px = gx & 1; // odd cells: the first tap is the far one
    int py = gy & 1;
    int base = y0 * 6 + x0;
    vec2 fx = (px == 0) ? vec2(2.0, 1.0) : vec2(1.0, 2.0);
    vec2 fy = (py == 0) ? vec2(2.0, 1.0) : vec2(1.0, 2.0);
    return (dot(dn, texel(base) - e0)     * (fx.x * fy.x)
          + dot(dn, texel(base + 1) - e0) * (fx.y * fy.x)
          + dot(dn, texel(base + 6) - e0) * (fx.x * fy.y)
          + dot(dn, texel(base + 7) - e0) * (fx.y * fy.y)) * (1.0 / 9.0);
#else
    // grid cell g sits at texel coordinate g * 4/3: x0 = floor, fraction in thirds
    int x0 = min((gx * 4) / 3, 3);
    int y0 = min((gy * 4) / 3, 3);
    float fx = float(gx * 4 - 3 * x0) * (1.0 / 3.0);
    float fy = float(gy * 4 - 3 * y0) * (1.0 / 3.0);
    int base = y0 * 5 + x0;
    return dot(dn, texel(base) - e0)     * ((1.0 - fx) * (1.0 - fy))
         + dot(dn, texel(base + 1) - e0) * (fx * (1.0 - fy))
         + dot(dn, texel(base + 5) - e0) * ((1.0 - fx) * fy)
         + dot(dn, texel(base + 6) - e0) * (fx * fy);
#endif
}

// Grid weight k as the decoder sees it, 0..64 (gu: one byte per weight).
float grid_value(uvec4 gu, int k)
{
    k = min(k, 15);
    return float((gu[k >> 2] >> uint(8 * (k & 3))) & 255u);
}

uvec4 encode_grid(TV e0, TV e1, out float err)
{
    TV d = e1 - e0;
    float dd = dot(d, d);
    float inv = 1.0 / max(dd, SMALL_VALUE);

    // pass 1: the 16 grid weights. gq: the stored index, 4 bits each; gu: the decoder's value
    uvec2 gq = uvec2(0u);
    uvec4 gu = uvec4(0u);
    int cells = min(uN, 16); // 16, but not a compile-time constant: keeps the loop rolled
    for (int i = 0; i < cells; ++i)
    {
        uint q = uint(clamp(grid_weight(i, e0, d * inv), 0.0, 1.0) * 11.0 + 0.5);
        gu[i >> 2] |= uint(unquant_weight(q, true) * 64.0 + 0.5) << uint(8 * (i & 3));
        q <<= uint(4 * (i & 7));
        if (i < 8) gq.x |= q; else gq.y |= q;
    }

    // pass 2: every texel with the weight the decoder interpolates for it (ASTC weight infill)
    float sw = 0.0, sww = 0.0, sp = 0.0, swp = 0.0, scc = 0.0;
    for (int i = 0; i < uN; ++i)
    {
        int y = i / DIM;
        int x = i - y * DIM;
        // position in the grid in 1/16 cells: scale = (1024 + DIM / 2) / (DIM - 1), 3 = grid size - 1
        ivec2 g = (ivec2(x, y) * (3 * ((1024 + DIM / 2) / (DIM - 1))) + 32) >> 6;
        ivec2 j = g >> 4;
        ivec2 f = g & 15;
        int k = j.y * 4 + j.x;
        int w11 = (f.x * f.y + 8) >> 4;
        float wu = floor((grid_value(gu, k)     * float(16 - f.x - f.y + w11)
                        + grid_value(gu, k + 1) * float(f.x - w11)
                        + grid_value(gu, k + 4) * float(f.y - w11)
                        + grid_value(gu, k + 5) * float(w11) + 8.0) * (1.0 / 16.0)) * (1.0 / 64.0);
        TV c = texel(i) - e0;
        float pc = dot(c, d);
        sw += wu;
        sww += wu * wu;
        sp += pc;
        swp += wu * pc;
        scc += dot(c, c);
    }

    // refit along the line and error, as in encode_block
    float n = float(BLOCK_SIZE);
    float al = dd * (n - 2.0 * sw + sww);
    float be = dd * (sw - sww);
    float ga = dd * sww;
    float r0 = sp - swp;
    float det = al * ga - be * be;
    float a = 0.0;
    float b = 1.0;
    if (det > 1e-4 * (al + ga) * (al + ga))
    {
        a = (ga * r0 - be * swp) / det;
        b = (al * swp - be * r0) / det;
        TV n0 = ep_quant(e0 + a * d, 8);
        TV n1 = ep_quant(e0 + b * d, 8);
        TV dn = n1 - n0;
        if (dn.r + dn.g + dn.b >= 0.0)
        {
            e0 = n0;
            e1 = n1;
        }
        else
        {
            a = 0.0;
            b = 1.0;
        }
    }
    err = scc - 2.0 * (a * r0 + b * swp) + a * a * al + 2.0 * a * b * be + b * b * ga;

    uvec2 ws = uvec2(0u);
    for (int g = 0; g < 4; ++g)
    {
        uint grp = 0u;
        for (int m = 0; m < 5; ++m)
        {
            int i = g * 5 + m;
            if (i >= cells)
                break;
            uint q = (((i < 8) ? gq.x : gq.y) >> uint(4 * (i & 7))) & 15u;
            grp |= scramble_weight(q, true) << uint(4 * m);
        }
        put2(ws, uint(g) * 18u, trit_group_bits(grp, 2u));
    }
    uvec4 blk = uvec4(0u);
    blk.x = MODE_4x4_Q12 | (CEM_LDR_RGB_DIRECT << 13u);
    uint pos = 17u;
    put_endpoints(blk, pos, e0, e1, 8, false);
    put_weights(blk, ws);
    return blk;
}
#endif

// ---------------------------------------------------------------------------
// two partitions (4x4 only)
//
// The texels are split in two groups, each with its own colour line, so a block with a hard edge
// between two areas no longer has to put both on one line. The format only offers a fixed set of
// split patterns; the table gives the closest one to a wanted split.
// Storage: opaque RGB 6 bit endpoints + 3 weight levels; with alpha RGBA 4 bit + 4 levels.
// ---------------------------------------------------------------------------

#if TWO_PARTITIONS
#ifndef PART_CANDIDATES
#define PART_CANDIDATES 2 // candidate splits tried per block, 1-3
#endif
#ifndef PART_MAX_MISMATCH
#define PART_MAX_MISMATCH 2 // skip a candidate split when the closest pattern differs in more texels than this
#endif

uint nearest_pattern(uint mask)
{
    return texelFetch(uPartLut, ivec2(int(mask & 255u), int((mask >> 8u) & 255u)), 0).r;
}

// Each group in turn: endpoints, weights, refit. Two passes over the group's own texels.
uvec4 encode_two_partitions(uint lut, bool opaque, out float err)
{
    uint pm = lut >> 16u; // bit i: group of texel i
    int ebits = opaque ? 6 : 4;
    float wmax = opaque ? 2.0 : 3.0;
    int n = min(uN, 16); // 16, but not a compile-time constant: keeps the loops rolled

    // block mode, partition count - 1, seed, 2 bits "same endpoint type for both", endpoint type
    uvec4 blk = uvec4(0u);
    blk.x = (opaque ? MODE_4x4_Q3 : MODE_4x4_Q4) | (1u << 11u) | ((lut & 1023u) << 13u)
          | ((opaque ? CEM_LDR_RGB_DIRECT : CEM_LDR_RGBA_DIRECT) << 25u);
    uint pos = 29u;
    uint wq = 0u; // 2 bits per texel
    err = 0.0;

    for (uint p = 0u; p < 2u; ++p)
    {
        // Endpoints: opposite corners of the group's bounding box. Which corner each channel
        // starts from follows the sign of its covariance with the widest channel. Exact for
        // two colours.
        TV mn = TV(255.0);
        TV mx = TV(0.0);
        TV s = TV(0.0);
#if HAS_ALPHA
        vec3 xr = vec3(0.0); // r*(g, b, a)
        vec3 xg = vec3(0.0); // g*b, g*a, b*a
#else
        vec3 xr = vec3(0.0); // r*g, r*b, g*b
#endif
        float cnt = 0.0;
        for (int i = 0; i < n; ++i)
        {
            if (((pm >> uint(i)) & 1u) != p)
                continue;
            TV t = texel(i);
            mn = min(mn, t);
            mx = max(mx, t);
            s += t;
            cnt += 1.0;
#if HAS_ALPHA
            xr += t.r * t.gba;
            xg += vec3(t.g * t.ba, t.b * t.a);
#else
            xr += vec3(t.r * t.gb, t.g * t.b);
#endif
        }
        TV m = s / max(cnt, 1.0);
        TV rng = mx - mn;
        TV sg;
#if HAS_ALPHA
        xr -= s.r * m.gba;
        xg -= vec3(s.g * m.ba, s.b * m.a);
        if (rng.r >= rng.g && rng.r >= rng.b && rng.r >= rng.a) sg = vec4(1.0, xr.x, xr.y, xr.z);
        else if (rng.g >= rng.b && rng.g >= rng.a)              sg = vec4(xr.x, 1.0, xg.x, xg.y);
        else if (rng.b >= rng.a)                                sg = vec4(xr.y, xg.x, 1.0, xg.z);
        else                                                    sg = vec4(xr.z, xg.y, xg.z, 1.0);
#else
        xr -= vec3(s.r * m.gb, s.g * m.b);
        if (rng.r >= rng.g && rng.r >= rng.b) sg = vec3(1.0, xr.x, xr.y);
        else if (rng.g >= rng.b)              sg = vec3(xr.x, 1.0, xr.z);
        else                                  sg = vec3(xr.y, xr.z, 1.0);
#endif
        TV q0, q1, e0, dn;
#if HAS_ALPHA
        bvec4 up = greaterThanEqual(sg, vec4(0.0));
#else
        bvec3 up = greaterThanEqual(sg, vec3(0.0));
#endif
        ep_pair(mix(mx, mn, up), mix(mn, mx, up), ebits, q0, q1, e0, dn);
        dn -= e0;
        dn *= 1.0 / max(dot(dn, dn), SMALL_VALUE);

        S2 sw = S2(0.0);
        S2 sww = S2(0.0);
        TV swt = TV(0.0);
        float sqq = 0.0;
#if WEIGHTED
        vec2 nn = vec2(0.0, cnt);
        s = vec4(0.0);
#else
        float nn = cnt;
#endif
        for (int i = 0; i < n; ++i)
        {
            if (((pm >> uint(i)) & 1u) != p)
                continue;
            TV t = texel(i);
            float q = floor(clamp(dot(t - e0, dn), 0.0, 1.0) * wmax + 0.5);
            float wu = opaque ? q * 0.5 : floor(q * 21.34) * (1.0 / 64.0); // 0,32,64 or 0,21,43,64
            wq |= uint(q) << uint(2 * i);
#if WEIGHTED
            vec2 om = vec2(t.a * (1.0 / 255.0), 1.0);
            vec4 ot = om.xxxy * t;
            nn.x += om.x;
            sw += wu * om;
            sww += wu * wu * om;
            swt += wu * ot;
            s += ot;
            sqq += dot(ot, t);
#else
            sw += wu;
            sww += wu * wu;
            swt += wu * t;
            sqq += dot(t, t);
#endif
        }
        refit(nn, sw, sww, swt, s, ebits, q0, q1);
        err += group_error(nn, sw, sww, swt, s, sqq, ebits, q0, q1);
        put_endpoints(blk, pos, q0, q1, ebits, !opaque);
    }

    uvec2 ws = uvec2(wq, 0u); // with alpha: two bits per weight, stored as they are
    if (opaque)
    {
        ws.x = 0u;
        for (int g = 0; g < 4; ++g)
        {
            uint grp = 0u;
            for (int j = 0; j < 5; ++j)
            {
                int i = g * 5 + j;
                if (i >= n)
                    break;
                grp |= ((wq >> uint(2 * i)) & 3u) << uint(4 * j);
            }
            ws.x |= trit_group_bits(grp, 0u) << uint(8 * g);
        }
    }
    put_weights(blk, ws);
    return blk;
}
#endif

// ---------------------------------------------------------------------------
// dual-plane encoding for blocks with alpha (4x4 only)
//
// RGB and alpha each get their own binary weights (QUANT_2, 16 + 16 bits): RGB blends between two
// colours, alpha between two alpha values. A block of "transparent + two opaque colours" (typical
// pixel art) is then exact, which one colour line per block cannot do. Used only when its error is
// lower than the single-plane encoding's.
// ---------------------------------------------------------------------------

#if DUAL_PLANE
float colour_weight(float a)
{
#if PREMULTIPLIED
    return 1.0;
#else
    return a + 1.0;
#endif
}

uvec4 encode_dual_plane(out float err)
{
    int n = min(uN, 16); // 16, but not a compile-time constant: keeps the loops rolled

    // pass 1: alpha range and alpha-weighted mean colour
    float amin = 255.0;
    float amax = 0.0;
    vec3 msum = vec3(0.0);
    float wsum = 0.0;
    for (int i = 0; i < n; ++i)
    {
        vec4 t = texel(i);
        amin = min(amin, t.a);
        amax = max(amax, t.a);
        float wt = colour_weight(t.a);
        msum += wt * t.rgb;
        wsum += wt;
    }
    if (amax - amin < 1.0)
    {
        err = 1e30; // constant alpha: nothing for a second plane to do
        return uvec4(0u);
    }
    vec3 mean = msum / wsum;

    // pass 2: weighted covariance of the colours -> main axis
    float c00 = 0.0, c01 = 0.0, c02 = 0.0, c11 = 0.0, c12 = 0.0, c22 = 0.0;
    for (int i = 0; i < n; ++i)
    {
        vec4 t = texel(i);
        vec3 d = t.rgb - mean;
        float wt = colour_weight(t.a);
        c00 += wt * d.x * d.x; c01 += wt * d.x * d.y; c02 += wt * d.x * d.z;
        c11 += wt * d.y * d.y; c12 += wt * d.y * d.z; c22 += wt * d.z * d.z;
    }
    // divide by the weight sum: the iteration squares the matrix twice and overflows otherwise
    vec3 axis = eigen_vector3(vec3(c00, c01, c02) / wsum, vec3(c11, c12, c22) / wsum);

    // pass 3: split the colours in two at the mean and take the weighted mean of each side
    vec3 s0 = vec3(0.0), s1 = vec3(0.0);
    float w0 = 0.0, w1 = 0.0;
    for (int i = 0; i < n; ++i)
    {
        vec4 t = texel(i);
        float wt = colour_weight(t.a);
        if (dot(t.rgb - mean, axis) > 0.0) { s1 += wt * t.rgb; w1 += wt; }
        else                               { s0 += wt * t.rgb; w0 += wt; }
    }
    vec3 e0 = (w0 > 0.0) ? s0 / w0 : ((w1 > 0.0) ? s1 / w1 : mean);
    vec3 e1 = (w1 > 0.0) ? s1 / w1 : e0;

    // 8 bit endpoints; the RGB decoder swaps endpoints (blue contraction) unless sum(e1) >= sum(e0)
    vec3 r0 = round(e0);
    vec3 r1 = round(e1);
    if (r0.x + r0.y + r0.z > r1.x + r1.y + r1.z)
    {
        vec3 tmp = r0; r0 = r1; r1 = tmp;
    }
    float a0 = round(amin);
    float a1 = round(amax);
    float amid = 0.5 * (a0 + a1);

    // pass 4: each pixel takes the nearer colour endpoint and the nearer alpha endpoint
    uint bits = 0u;
    err = 0.0;
    for (int i = 0; i < n; ++i)
    {
        vec4 t = texel(i);
        vec3 d0 = t.rgb - r0;
        vec3 d1 = t.rgb - r1;
        bool hi = dot(d1, d1) < dot(d0, d0);
        bool ahi = t.a > amid;
        err += pixel_error(t, vec4(hi ? r1 : r0, ahi ? a1 : a0));
        bits |= (hi ? 1u : 0u) << uint(2 * i);
        bits |= (ahi ? 1u : 0u) << uint(2 * i + 1);
    }

    // Endpoints are RGBA direct, weights are the interleaved bit stream; the colour component
    // selector (3: alpha has its own weights) sits just below the weights.
    uvec4 blk = uvec4(0u);
    blk.x = MODE_4x4_Q2_DUAL | (CEM_LDR_RGBA_DIRECT << 13u);
    uint pos = 17u;
    put_endpoints(blk, pos, vec4(r0, a0), vec4(r1, a1), 8, true);
    put_weights(blk, uvec2(bits, 0u));
    blk.z |= 3u << 30u;
    return blk;
}
#endif

void main()
{
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    if (b.x >= uBlocks.x || b.y >= uBlocks.y)
        return;
    g_origin = b * DIM;
    int index = b.y * uBlocks.x + b.x;

    float err, round_err;
    bool opaque;
    TV e0, e1;
    int far;
    // Written first so the single-plane state is dead before the other searches start
    // (this lowers register use).
    blocks[index] = encode_block(err, round_err, opaque, e0, e1, far);

#if GRID_MODE
    if (round_err > GRID_ERR_THRESHOLD)
    {
        float e2;
        uvec4 blk = encode_grid(e0, e1, e2);
        if (e2 < err)
            blocks[index] = blk;
    }
#endif
#if DUAL_PLANE
    if (!opaque && err > DUAL_ERR_THRESHOLD)
    {
        float e2;
        uvec4 blk = encode_dual_plane(e2);
        if (e2 < err)
        {
            blocks[index] = blk;
            err = e2;
        }
    }
#endif
#if TWO_PARTITIONS
    if (err > ALT_ERR_THRESHOLD)
    {
        // Sort the texels by which of three colours they are nearest to: the two stored endpoints
        // and the texel farthest off their line. Candidate splits: each of those groups against
        // the rest. The table says how closely the format can reproduce each split.
        int n = min(uN, 16);
        TV third = texel(far);
        uvec3 grp = uvec3(0u);
        for (int i = 0; i < n; ++i)
        {
            TV t = texel(i);
            TV d0 = t - e0, d1 = t - e1, d2 = t - third;
            float l0 = dot(d0, d0), l1 = dot(d1, d1), l2 = dot(d2, d2);
            if (l2 < l0 && l2 < l1) grp.z |= 1u << uint(i);
            else if (l1 < l0)       grp.y |= 1u << uint(i);
            else                    grp.x |= 1u << uint(i);
        }
        uvec3 lut = uvec3(nearest_pattern(grp.z), nearest_pattern(grp.x), nearest_pattern(grp.y));
        uvec3 miss = (lut >> 10u) & 31u;
        // try the closest fits first; a split that needs more than a few texels moved is no use
        for (int k = 0; k < PART_CANDIDATES; ++k)
        {
            uint best = min(miss.x, min(miss.y, miss.z));
            if (best > uint(PART_MAX_MISMATCH) || err <= ALT_ERR_THRESHOLD)
                break;
            uint pick;
            if (miss.x == best)      { pick = lut.x; miss.x = 99u; }
            else if (miss.y == best) { pick = lut.y; miss.y = 99u; }
            else                     { pick = lut.z; miss.z = 99u; }
            // the same pattern can be the closest to more than one split
            if ((miss.x != 99u && (lut.x & 1023u) == (pick & 1023u)) ) miss.x = 99u;
            if ((miss.y != 99u && (lut.y & 1023u) == (pick & 1023u)) ) miss.y = 99u;
            if ((miss.z != 99u && (lut.z & 1023u) == (pick & 1023u)) ) miss.z = 99u;
            float e2;
            uvec4 blk = encode_two_partitions(pick, opaque, e2);
            if (e2 < err)
            {
                blocks[index] = blk;
                err = e2;
            }
        }
    }
#endif
}
