// GPU-ASTC: ASTC LDR block encoder, OpenGL ES 3.1 compute shader.
//
// The host prepends "#version 310 es" and the option defines below.
//
// Derived from niepp/astc_encoder (MIT, Copyright (c) 2021 niedap),
// ported from HLSL. See THIRD_PARTY_NOTICES.md.
//
// One invocation encodes one block: single partition, single plane,
// 4x4 weight grid, RGB or RGBA direct endpoints (8 bit, unquantized).

precision highp float;
precision highp int;
precision highp sampler2D;

#ifndef BLOCK_6X6
#define BLOCK_6X6 0
#endif
#ifndef HAS_ALPHA
#define HAS_ALPHA 0
#endif
#ifndef IS_NORMALMAP
#define IS_NORMALMAP 0
#endif

#if BLOCK_6X6
#define DIM 6
#else
#define DIM 4
#endif

#define BLOCK_SIZE ((DIM) * (DIM))
#define X_GRIDS 4
#define Y_GRIDS 4
#define SMALL_VALUE 0.00001

#define CEM_LDR_RGB_DIRECT 8u
#define CEM_LDR_RGBA_DIRECT 12u

#define QUANT_6 4
#define QUANT_12 7

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

uniform ivec2 uTexSize;   // source size in texels
uniform ivec2 uBlocks;    // size in blocks
uniform int uN;           // BLOCK_SIZE (non-constant so loops are not unrolled)
layout(binding = 0) uniform highp sampler2D uTex;
layout(std430, binding = 0) writeonly buffer OutBuffer { uvec4 blocks[]; };

// ---------------------------------------------------------------------------
// bit packing (bounded integer sequence encoding), specialised for the fixed modes:
//   endpoints: 8 bits each (QUANT_256), no trits/quints
//   weights:   QUANT_12 (2 bits + trit) opaque, QUANT_6 (1 bit + trit) with alpha
// Everything is pure arithmetic: no lookup tables, so nothing is spilled to memory.
// ---------------------------------------------------------------------------

#if HAS_ALPHA
#define WT_BITS 1u
#define WEIGHT_RANGE 6u
#else
#define WT_BITS 2u
#define WEIGHT_RANGE 12u
#endif

// Or the low bitcount bits of number into o at bitoffset. number <= 255.
void orbits8_ptr(inout uvec4 o, inout uint bitoffset, uint number, uint bitcount)
{
    uint newpos = bitoffset + bitcount;
    uint uidx = bitoffset >> 5u;
    uint nidx = newpos >> 5u;
    uint sh = bitoffset & 31u;
    uint lo = number << sh;
    uint hi = (nidx > uidx) ? (number >> ((32u - sh) & 31u)) : 0u;
    if (uidx == 0u)      { o.x |= lo; o.y |= hi; }
    else if (uidx == 1u) { o.y |= lo; o.z |= hi; }
    else if (uidx == 2u) { o.z |= lo; o.w |= hi; }
    else                 { o.w |= lo; }
    bitoffset = newpos;
}

uint reverse_byte(uint p)
{
    p = ((p & 0xFu) << 4u) | ((p >> 4u) & 0xFu);
    p = ((p & 0x33u) << 2u) | ((p >> 2u) & 0x33u);
    p = ((p & 0x55u) << 1u) | ((p >> 1u) & 0x55u);
    return p;
}

// Weight scramble for QUANT_12 / QUANT_6, as packed 4 bit entries.
uint scramble_weight(uint q)
{
#if HAS_ALPHA
    return (0x135420u >> (q * 4u)) & 15u;                    // {0,2,4,5,3,1}
#else
    uint v = (q < 8u) ? (0x7BA62840u >> (q * 4u))            // {0,4,8,2,6,10,11,7,3,9,5,1}
                      : (0x1593u >> ((q - 8u) * 4u));
    return v & 15u;
#endif
}

// Packs five trits (0..2) into the 8 bit ASTC trit block. Same values as the
// reference integer_from_trits table, derived from the spec's decode rules.
uint pack_trits(uint t0, uint t1, uint t2, uint t3, uint t4)
{
    uint c;
    if (t2 == 2u)
        c = (t1 == 2u) ? (12u + t0) : ((t1 << 4u) | ((t0 == 2u) ? 12u : (t0 << 2u)) | 3u);
    else
        c = (t2 << 4u) | (t1 << 2u) | t0;

    if (t3 == 2u && t4 == 2u)
    {
        if (t2 == 2u && t1 == 2u) c |= 16u;
        return ((c >> 2u) << 5u) | 28u | (c & 3u);
    }
    if ((c >> 2u) == 7u) c &= ~4u;
    return (t4 == 2u) ? (c | (3u << 5u) | (t3 << 7u))
                      : (c | (t3 << 5u) | (t4 << 7u));
}

// One group of five weights: 5 low-bit fields interleaved with the 8 trit bits.
void encode_trit_group(uint b0, uint b1, uint b2, uint b3, uint b4,
                       inout uvec4 outputs, inout uint outpos)
{
    const uint mask = (1u << WT_BITS) - 1u;
    uint packhigh = pack_trits(b0 >> WT_BITS, b1 >> WT_BITS, b2 >> WT_BITS, b3 >> WT_BITS, b4 >> WT_BITS);

    orbits8_ptr(outputs, outpos, b0 & mask, WT_BITS);
    orbits8_ptr(outputs, outpos, packhigh & 3u, 2u);
    orbits8_ptr(outputs, outpos, b1 & mask, WT_BITS);
    orbits8_ptr(outputs, outpos, (packhigh >> 2u) & 3u, 2u);
    orbits8_ptr(outputs, outpos, b2 & mask, WT_BITS);
    orbits8_ptr(outputs, outpos, (packhigh >> 4u) & 1u, 1u);
    orbits8_ptr(outputs, outpos, b3 & mask, WT_BITS);
    orbits8_ptr(outputs, outpos, (packhigh >> 5u) & 3u, 2u);
    orbits8_ptr(outputs, outpos, b4 & mask, WT_BITS);
    orbits8_ptr(outputs, outpos, (packhigh >> 7u) & 1u, 1u);
}

// ---------------------------------------------------------------------------
// endpoints: principal component analysis
// ---------------------------------------------------------------------------

// Power iteration for the dominant axis. The original used 8 iterations; quality is
// unchanged down to 3 (measured), which cuts about 40% of the arithmetic.
#define EIGEN_ITERATIONS 3
vec4 eigen_vector(mat4 m)
{
    vec4 v = vec4(0.26726, 0.80178, 0.53452, 0.0);
    for (int i = 0; i < EIGEN_ITERATIONS; ++i)
    {
        v = m * v;
        if (length(v) < SMALL_VALUE)
            return v;
        v = normalize(m * v);
    }
    return v;
}

// Texels are re-fetched from the texture in each pass instead of being kept in
// registers: a 4x4 block would otherwise need 64 registers just for its pixels.
ivec2 g_origin; // first texel of this thread's block

vec4 texel(int k)
{
    int y = k / DIM;
    int x = k - y * DIM;
    // replicate edge texels for partial blocks
    ivec2 p = min(g_origin + ivec2(x, y), uTexSize - ivec2(1));
    vec4 t = texelFetch(uTex, p, 0);
#if IS_NORMALMAP
    t.b = 1.0;
    t.a = 1.0;
#endif
    return t * 255.0;
}

void find_min_max(vec4 pt_mean, vec4 vec_k, out vec4 e0, out vec4 e1)
{
    float a = 1e31;
    float b = -1e31;
    for (int i = 0; i < uN; ++i)
    {
        float t = dot(texel(i) - pt_mean, vec_k);
        a = min(a, t);
        b = max(b, t);
    }

    e0 = clamp(vec_k * a + pt_mean, 0.0, 255.0);
    e1 = clamp(vec_k * b + pt_mean, 0.0, 255.0);

    // make the first endpoint the darkest one
    vec4 e0u = round(e0);
    vec4 e1u = round(e1);
    if (e0u.x + e0u.y + e0u.z > e1u.x + e1u.y + e1u.z)
    {
        vec4 tmp = e0;
        e0 = e1;
        e1 = tmp;
    }

#if !HAS_ALPHA
    e0.a = 255.0;
    e1.a = 255.0;
#endif
}

void principal_component_analysis(out vec4 e0, out vec4 e1)
{
    vec4 pt_mean = vec4(0.0);
    for (int i = 0; i < uN; ++i)
        pt_mean += texel(i);
    pt_mean /= float(BLOCK_SIZE);

    // covariance is symmetric: accumulate the 10 unique entries
    float c00 = 0.0, c01 = 0.0, c02 = 0.0, c03 = 0.0, c11 = 0.0, c12 = 0.0, c13 = 0.0, c22 = 0.0, c23 = 0.0, c33 = 0.0;
    for (int k = 0; k < uN; ++k)
    {
        vec4 t = texel(k) - pt_mean;
        c00 += t.x * t.x; c01 += t.x * t.y; c02 += t.x * t.z; c03 += t.x * t.w;
        c11 += t.y * t.y; c12 += t.y * t.z; c13 += t.y * t.w;
        c22 += t.z * t.z; c23 += t.z * t.w;
        c33 += t.w * t.w;
    }
    mat4 cov = mat4(c00, c01, c02, c03,
                    c01, c11, c12, c13,
                    c02, c12, c22, c23,
                    c03, c13, c23, c33);
    cov /= float(BLOCK_SIZE - 1);

    vec4 vec_k = eigen_vector(cov);
    find_min_max(pt_mean, vec_k, e0, e1);
}

// ---------------------------------------------------------------------------
// weights
// ---------------------------------------------------------------------------

uint quantize_weight(uint weight_range, float weight)
{
    uint q = uint(round(max(weight, 0.0) * float(weight_range)));
    return min(q, weight_range);
}

// Bilinear tap weight for 6x6 -> 4x4 grid resampling: 0, 1 or 2 "far" taps.
float tap_weight(int far)
{
    return (far == 0) ? 0.444 : ((far == 1) ? 0.222 : 0.111);
}

// Projection of weight-grid cell i onto the endpoint axis, relative to endpoint 0
// (k0 = dot(vec_k, ep0)). Each texel is projected to a scalar as soon as it is fetched.
float weight_proj(int i, vec4 vec_k, float k0)
{
#if BLOCK_6X6
    // bilinear resample of the 6x6 block onto the 4x4 weight grid: cell (gx, gy)
    // covers texels x0..x0+1, y0..y0+1 with x0, y0 in {0,1,3,4}.
    int gx = i & 3;
    int gy = i >> 2;
    int x0 = gx + (gx >> 1);
    int y0 = gy + (gy >> 1);
    int px = gx & 1;  // odd cells: first tap is the far one
    int py = gy & 1;
    int base = y0 * 6 + x0;
    float sum = dot(vec_k, texel(base))     * tap_weight(px + py)
              + dot(vec_k, texel(base + 1)) * tap_weight((1 - px) + py)
              + dot(vec_k, texel(base + 6)) * tap_weight(px + (1 - py))
              + dot(vec_k, texel(base + 7)) * tap_weight((1 - px) + (1 - py));
#else
    float sum = dot(vec_k, texel(i));
#endif
    return sum - k0;
}

// Quantized, scrambled weight for cell i. minw/invlen come from weight_range_pass().
uint weight_q(int i, vec4 vec_k, float k0, float minw, float invlen)
{
    float w = (weight_proj(i, vec_k, k0) - minw) * invlen;
    return scramble_weight(quantize_weight(WEIGHT_RANGE - 1u, w));
}

// ---------------------------------------------------------------------------
// block assembly
// ---------------------------------------------------------------------------

uvec4 assemble_block(uint blockmode, uint color_endpoint_mode, uvec4 ep_ise, uvec4 wt_ise)
{
    uvec4 blk = uvec4(0u);

    // weights are stored bit-reversed from the end of the block
    blk.w |= reverse_byte(wt_ise.x & 0xFFu) << 24u;
    blk.w |= reverse_byte((wt_ise.x >> 8u) & 0xFFu) << 16u;
    blk.w |= reverse_byte((wt_ise.x >> 16u) & 0xFFu) << 8u;
    blk.w |= reverse_byte((wt_ise.x >> 24u) & 0xFFu);

    blk.z |= reverse_byte(wt_ise.y & 0xFFu) << 24u;
    blk.z |= reverse_byte((wt_ise.y >> 8u) & 0xFFu) << 16u;
    blk.z |= reverse_byte((wt_ise.y >> 16u) & 0xFFu) << 8u;
    blk.z |= reverse_byte((wt_ise.y >> 24u) & 0xFFu);

    blk.y |= reverse_byte(wt_ise.z & 0xFFu) << 24u;
    blk.y |= reverse_byte((wt_ise.z >> 8u) & 0xFFu) << 16u;
    blk.y |= reverse_byte((wt_ise.z >> 16u) & 0xFFu) << 8u;
    blk.y |= reverse_byte((wt_ise.z >> 24u) & 0xFFu);

    blk.x = blockmode;                          // 11 bits
    blk.x |= (color_endpoint_mode & 0xFu) << 13u; // 4 bits, single partition

    // endpoints start at bit 17 for a single partition
    blk.x |= (ep_ise.x & 0x7FFFu) << 17u;
    blk.y |= (ep_ise.x >> 15u) & 0x1FFFFu;
    blk.y |= (ep_ise.y & 0x7FFFu) << 17u;
    blk.z |= (ep_ise.y >> 15u) & 0x1FFFFu;
    return blk;
}

// "Table C.2.8 - 2D Block Mode Layout", first row.
uint assemble_blockmode(uint weight_quantmethod)
{
    uint a = uint(Y_GRIDS - 2) & 3u;
    uint b = uint(X_GRIDS - 4) & 3u;
    uint d = 0u; // dual plane
    uint h = (weight_quantmethod < 6u) ? 0u : 1u;
    uint r = (weight_quantmethod % 6u) + 2u;

    uint blockmode = (r >> 1u) & 3u;
    blockmode |= (r & 1u) << 4u;
    blockmode |= a << 5u;
    blockmode |= b << 7u;
    blockmode |= h << 9u;
    blockmode |= d << 10u;
    return blockmode;
}

uvec4 encode_block()
{
    vec4 ep0, ep1;
    principal_component_analysis(ep0, ep1);

    // fixed modes: endpoints 8 bit, weights QUANT_6 (alpha) or QUANT_12 (opaque)
#if HAS_ALPHA
    const int weight_quantmethod = QUANT_6;
    const uint color_endpoint_mode = CEM_LDR_RGBA_DIRECT;
#else
    const int weight_quantmethod = QUANT_12;
    const uint color_endpoint_mode = CEM_LDR_RGB_DIRECT;
#endif

    uint blockmode = assemble_blockmode(uint(weight_quantmethod));

    // endpoints: 8 bit values, the bounded integer sequence is just the bytes
    uvec4 a = uvec4(round(ep0));
    uvec4 b = uvec4(round(ep1));
#if HAS_ALPHA
    uvec4 ep_ise = uvec4(a.r | (b.r << 8u) | (a.g << 16u) | (b.g << 24u),
                         a.b | (b.b << 8u) | (a.a << 16u) | (b.a << 24u), 0u, 0u);
#else
    uvec4 ep_ise = uvec4(a.r | (b.r << 8u) | (a.g << 16u) | (b.g << 24u),
                         a.b | (b.b << 8u), 0u, 0u);
#endif

#if BLOCK_6X6
    // 6x6: every projection needs 4 texel fetches, so compute each cell once and keep it.
    // weights: project every grid cell once (kept in registers), then quantize.
    // A degenerate axis (flat block) gives vec_k = 0, so every projection is 0 and every weight 0.
    vec4 vec_k = ep1 - ep0;
    vec_k = (length(vec_k) < SMALL_VALUE) ? vec4(0.0) : normalize(vec_k);
    float k0 = dot(vec_k, ep0);

    float wv[X_GRIDS * Y_GRIDS];
    float minw = 1e31;
    float maxw = -1e31;
    for (int i = 0; i < X_GRIDS * Y_GRIDS; ++i)
    {
        float w = weight_proj(i, vec_k, k0);
        wv[i] = w;
        minw = min(w, minw);
        maxw = max(w, maxw);
    }
    float invlen = 1.0 / max(SMALL_VALUE, maxw - minw);

    uvec2 wq = uvec2(0u);
    for (int i = 0; i < X_GRIDS * Y_GRIDS; ++i)
    {
        uint q = scramble_weight(quantize_weight(WEIGHT_RANGE - 1u, (wv[i] - minw) * invlen)) << (uint(i & 7) * 4u);
        if (i < 8) wq.x |= q; else wq.y |= q;
    }
#else
    // 4x4: first pass finds the projection range, second pass recomputes and quantizes.
    // This keeps register use at 32 (full occupancy on Mali G31).
    vec4 vec_k = ep1 - ep0;
    bool degenerate = length(vec_k) < SMALL_VALUE;
    vec_k = degenerate ? vec4(0.0) : normalize(vec_k);

    float k0 = dot(vec_k, ep0);
    const int nw_max = X_GRIDS * Y_GRIDS;
    int nw = min(uN, nw_max); // 16, but not a compile-time constant (keeps loops rolled)
    float minw = 0.0;
    float invlen = 0.0;
    if (!degenerate)
    {
        float maxw = -1e31;
        minw = 1e31;
        for (int i = 0; i < nw; ++i)
        {
            float w = weight_proj(i, vec_k, k0);
            minw = min(w, minw);
            maxw = max(w, maxw);
        }
        invlen = 1.0 / max(SMALL_VALUE, maxw - minw);
    }

    // pass 2: quantize each weight to 4 bits (values < 12) and keep them in two uints
    uvec2 wq = uvec2(0u);
    for (int i = 0; i < nw; ++i)
    {
        uint q = weight_q(i, vec_k, k0, minw, invlen) << (uint(i & 7) * 4u);
        if (i < 8) wq.x |= q; else wq.y |= q;
    }
#endif

#define WQ(i) ((((i) < 8 ? wq.x : wq.y) >> (uint((i) & 7) * 4u)) & 15u)

    uvec4 wt_ise = uvec4(0u);
    uint bitpos = 0u;
    encode_trit_group(WQ(0), WQ(1), WQ(2), WQ(3), WQ(4), wt_ise, bitpos);
    encode_trit_group(WQ(5), WQ(6), WQ(7), WQ(8), WQ(9), wt_ise, bitpos);
    encode_trit_group(WQ(10), WQ(11), WQ(12), WQ(13), WQ(14), wt_ise, bitpos);
    encode_trit_group(WQ(15), 0u, 0u, 0u, 0u, wt_ise, bitpos);

    return assemble_block(blockmode, color_endpoint_mode, ep_ise, wt_ise);
}

void main()
{
    ivec2 b = ivec2(gl_GlobalInvocationID.xy);
    if (b.x >= uBlocks.x || b.y >= uBlocks.y)
        return;
    g_origin = b * DIM;
    blocks[b.y * uBlocks.x + b.x] = encode_block();
}
